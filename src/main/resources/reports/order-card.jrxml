<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="order-card" pageWidth="595" pageHeight="842" columnWidth="515" leftMargin="40" rightMargin="40" topMargin="50" bottomMargin="50">
    <dataset name="History">
        <field name="action" class="java.lang.String"/>
        <field name="field" class="java.lang.String"/>
        <field name="oldValue" class="java.lang.String"/>
        <field name="newValue" class="java.lang.String"/>
        <field name="actorLogin" class="java.lang.String"/>
        <field name="createdAt" class="java.util.Date"/>
    </dataset>
    <parameter name="printedBy" class="java.lang.String"/>
    <parameter name="history" class="net.sf.jasperreports.engine.JRDataSource"/>
    <field name="number" class="java.lang.String"/>
    <field name="customer" class="java.lang.String"/>
    <field name="status" class="java.lang.String"/>
    <field name="total" class="java.math.BigDecimal"/>
    <field name="createdAt" class="java.util.Date"/>
    <title height="30">
        <element kind="staticText" x="0" y="0" width="515" height="25" fontName="DejaVu Sans" fontSize="14.0" bold="true">
            <text><![CDATA[Карточка заказа]]></text>
        </element>
    </title>
    <detail>
        <band height="100">
            <element kind="staticText" x="0" y="0" width="120" height="20" fontName="DejaVu Sans" bold="true">
                <text><![CDATA[Номер]]></text>
            </element>
            <element kind="textField" x="120" y="0" width="395" height="20" fontName="DejaVu Sans">
                <expression><![CDATA[$F{number}]]></expression>
            </element>
            <element kind="staticText" x="0" y="20" width="120" height="20" fontName="DejaVu Sans" bold="true">
                <text><![CDATA[Заказчик]]></text>
            </element>
            <element kind="textField" x="120" y="20" width="395" height="20" fontName="DejaVu Sans">
                <expression><![CDATA[$F{customer}]]></expression>
            </element>
            <element kind="staticText" x="0" y="40" width="120" height="20" fontName="DejaVu Sans" bold="true">
                <text><![CDATA[Статус]]></text>
            </element>
            <element kind="textField" x="120" y="40" width="395" height="20" fontName="DejaVu Sans">
                <expression><![CDATA[$F{status}]]></expression>
            </element>
            <element kind="staticText" x="0" y="60" width="120" height="20" fontName="DejaVu Sans" bold="true">
                <text><![CDATA[Сумма]]></text>
            </element>
            <element kind="textField" x="120" y="60" width="395" height="20" fontName="DejaVu Sans" pattern="#,##0.00" blankWhenNull="true">
                <expression><![CDATA[$F{total}]]></expression>
            </element>
            <element kind="staticText" x="0" y="80" width="120" height="20" fontName="DejaVu Sans" bold="true">
                <text><![CDATA[Создан]]></text>
            </element>
            <element kind="textField" x="120" y="80" width="395" height="20" fontName="DejaVu Sans" pattern="dd.MM.yyyy HH:mm">
                <expression><![CDATA[$F{createdAt}]]></expression>
            </element>
        </band>
    </detail>
    <summary height="95">
        <element kind="staticText" x="0" y="10" width="515" height="20" fontName="DejaVu Sans" bold="true">
            <text><![CDATA[История изменений]]></text>
        </element>
        <element kind="component" x="0" y="35" width="515" height="30">
            <component kind="table">
                <datasetRun subDataset="History">
                    <dataSourceExpression><![CDATA[$P{history}]]></dataSourceExpression>
                </datasetRun>
                <column kind="single" width="85">
                    <columnHeader height="15">
                        <element kind="staticText" x="0" y="0" width="85" height="15" fontName="DejaVu Sans" fontSize="8.0" bold="true">
                            <text><![CDATA[Когда]]></text>
                        </element>
                    </columnHeader>
                    <detailCell height="15">
                        <element kind="textField" x="0" y="0" width="85" height="15" fontName="DejaVu Sans" fontSize="8.0" pattern="dd.MM.yyyy HH:mm">
                            <expression><![CDATA[$F{createdAt}]]></expression>
                        </element>
                    </detailCell>
                </column>
                <column kind="single" width="60">
                    <columnHeader height="15">
                        <element kind="staticText" x="0" y="0" width="60" height="15" fontName="DejaVu Sans" fontSize="8.0" bold="true">
                            <text><![CDATA[Действие]]></text>
                        </element>
                    </columnHeader>
                    <detailCell height="15">
                        <element kind="textField" x="0" y="0" width="60" height="15" fontName="DejaVu Sans" fontSize="8.0">
                            <expression><![CDATA[$F{action}]]></expression>
                        </element>
                    </detailCell>
                </column>
                <column kind="single" width="80">
                    <columnHeader height="15">
                        <element kind="staticText" x="0" y="0" width="80" height="15" fontName="DejaVu Sans" fontSize="8.0" bold="true">
                            <text><![CDATA[Поле]]></text>
                        </element>
                    </columnHeader>
                    <detailCell height="15">
                        <element kind="textField" x="0" y="0" width="80" height="15" fontName="DejaVu Sans" fontSize="8.0" blankWhenNull="true">
                            <expression><![CDATA[$F{field}]]></expression>
                        </element>
                    </detailCell>
                </column>
                <column kind="single" width="100">
                    <columnHeader height="15">
                        <element kind="staticText" x="0" y="0" width="100" height="15" fontName="DejaVu Sans" fontSize="8.0" bold="true">
                            <text><![CDATA[Было]]></text>
                        </element>
                    </columnHeader>
                    <detailCell height="15">
                        <element kind="textField" x="0" y="0" width="100" height="15" fontName="DejaVu Sans" fontSize="8.0" blankWhenNull="true">
                            <expression><![CDATA[$F{oldValue}]]></expression>
                        </element>
                    </detailCell>
                </column>
                <column kind="single" width="100">
                    <columnHeader height="15">
                        <element kind="staticText" x="0" y="0" width="100" height="15" fontName="DejaVu Sans" fontSize="8.0" bold="true">
                            <text><![CDATA[Стало]]></text>
                        </element>
                    </columnHeader>
                    <detailCell height="15">
                        <element kind="textField" x="0" y="0" width="100" height="15" fontName="DejaVu Sans" fontSize="8.0" blankWhenNull="true">
                            <expression><![CDATA[$F{newValue}]]></expression>
                        </element>
                    </detailCell>
                </column>
                <column kind="single" width="90">
                    <columnHeader height="15">
                        <element kind="staticText" x="0" y="0" width="90" height="15" fontName="DejaVu Sans" fontSize="8.0" bold="true">
                            <text><![CDATA[Кто]]></text>
                        </element>
                    </columnHeader>
                    <detailCell height="15">
                        <element kind="textField" x="0" y="0" width="90" height="15" fontName="DejaVu Sans" fontSize="8.0" blankWhenNull="true">
                            <expression><![CDATA[$F{actorLogin}]]></expression>
                        </element>
                    </detailCell>
                </column>
            </component>
        </element>
        <element kind="textField" x="0" y="75" width="515" height="20" fontName="DejaVu Sans" fontSize="8.0">
            <expression><![CDATA["Напечатал: " + $P{printedBy}]]></expression>
        </element>
    </summary>
</jasperReport>
