<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="demo-sales-table" pageWidth="595" pageHeight="842" columnWidth="515" leftMargin="40" rightMargin="40" topMargin="40" bottomMargin="40">
    <dataset name="SalesRows">
        <field name="product" class="java.lang.String"/>
        <field name="department" class="java.lang.String"/>
        <field name="quantity" class="java.lang.Integer"/>
        <field name="price" class="java.math.BigDecimal"/>
        <field name="amount" class="java.math.BigDecimal"/>
    </dataset>
    <parameter name="rows" class="net.sf.jasperreports.engine.JRDataSource"/>
    <title height="50">
        <element kind="staticText" x="0" y="0" width="515" height="32" fontName="DejaVu Sans" fontSize="18" bold="true"><text><![CDATA[Демо — Jasper Table]]></text></element>
        <element kind="staticText" x="0" y="31" width="515" height="18" fontName="DejaVu Sans" fontSize="10"><text><![CDATA[SubDataset, JRDataSource и табличный компонент]]></text></element>
    </title>
    <summary height="205">
        <element kind="component" x="0" y="0" width="515" height="195">
            <component kind="table">
                <datasetRun subDataset="SalesRows"><dataSourceExpression><![CDATA[$P{rows}]]></dataSourceExpression></datasetRun>
                <column kind="single" width="140">
                    <columnHeader height="24"><element kind="staticText" x="2" y="2" width="136" height="20" fontName="DejaVu Sans" bold="true"><text><![CDATA[Товар]]></text></element></columnHeader>
                    <detailCell height="26"><element kind="textField" x="2" y="2" width="136" height="20" fontName="DejaVu Sans"><expression><![CDATA[$F{product}]]></expression></element></detailCell>
                </column>
                <column kind="single" width="140">
                    <columnHeader height="24"><element kind="staticText" x="2" y="2" width="136" height="20" fontName="DejaVu Sans" bold="true"><text><![CDATA[Категория]]></text></element></columnHeader>
                    <detailCell height="26"><element kind="textField" x="2" y="2" width="136" height="20" fontName="DejaVu Sans"><expression><![CDATA[$F{department}]]></expression></element></detailCell>
                </column>
                <column kind="single" width="65">
                    <columnHeader height="24"><element kind="staticText" x="2" y="2" width="61" height="20" fontName="DejaVu Sans" bold="true"><text><![CDATA[Кол-во]]></text></element></columnHeader>
                    <detailCell height="26"><element kind="textField" x="2" y="2" width="61" height="20" fontName="DejaVu Sans"><expression><![CDATA[$F{quantity}]]></expression></element></detailCell>
                </column>
                <column kind="single" width="85">
                    <columnHeader height="24"><element kind="staticText" x="2" y="2" width="81" height="20" fontName="DejaVu Sans" bold="true"><text><![CDATA[Цена]]></text></element></columnHeader>
                    <detailCell height="26"><element kind="textField" x="2" y="2" width="81" height="20" fontName="DejaVu Sans" pattern="#,##0.00"><expression><![CDATA[$F{price}]]></expression></element></detailCell>
                </column>
                <column kind="single" width="85">
                    <columnHeader height="24"><element kind="staticText" x="2" y="2" width="81" height="20" fontName="DejaVu Sans" bold="true"><text><![CDATA[Сумма]]></text></element></columnHeader>
                    <detailCell height="26"><element kind="textField" x="2" y="2" width="81" height="20" fontName="DejaVu Sans" pattern="#,##0.00"><expression><![CDATA[$F{amount}]]></expression></element></detailCell>
                </column>
            </component>
        </element>
    </summary>
</jasperReport>
